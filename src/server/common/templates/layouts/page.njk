{% extends "govuk/template.njk" %}

{# Import GOVUK components globally #}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "govuk/components/generic-header/macro.njk" import govukGenericHeader %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}

{# Import custom components globally #}
{% from "heading/macro.njk" import appHeading %}
{% from "date-input/macro.njk" import appDateInput %}

{% set mainClasses = "app-main-wrapper" %}

{% block headIcons %}
  <link rel="icon" sizes="48x48" href="{{ getAssetPath("src/client/images/favicon.ico") }}">
  <link rel="icon" sizes="any" href="{{ getAssetPath("src/client/images/favicon.svg") }}" type="image/svg+xml" >
  <link rel="mask-icon" href="{{ getAssetPath("node_modules/govuk-frontend/dist/govuk/assets/images/govuk-icon-mask.svg") }}" color="{{ themeColor }}">
  <link rel="apple-touch-icon" href="{{ getAssetPath("node_modules/govuk-frontend/dist/govuk/assets/images/govuk-icon-180.png") }}">
  <link rel="manifest" href="{{ getAssetPath("node_modules/govuk-frontend/dist/govuk/assets/manifest.json") }}">
{% endblock %}

{% block head %}
  <link href="{{ getAssetPath('src/client/stylesheets/application.scss') }}" rel="stylesheet">
{% endblock %}

{% block header %}
  <header class="defra-header">
    <div class="defra-header__inner">
      <div class="defra-header__brand-group">
        <img src="{{ getAssetPath('src/client/images/defra-logo.svg') }}" alt="" role="presentation" class="defra-header__logo">
        <a href="/" class="defra-header__service-name">
          <span class="govuk-visually-hidden">Department for Environment, Food and Rural Affairs: </span>DWT Admin Portal
        </a>
      </div>
    </div>
  </header>

  {{ govukServiceNavigation({
    navigation: navigation
  }) }}
{% endblock %}

{% block pageTitle %}
  {{ pageTitle }} | {{ serviceName }}
{% endblock %}

{% block content %}
  {% if errors | length > 0 %}
    {% set errorList = [] %}
    {% for fieldId, message in errors %}
      {% set errorList = (errorList.push({ text: message, href: "#" + fieldId }), errorList) %}
    {% endfor %}
    {{ govukErrorSummary({
      titleText: "There is a problem",
      errorList: errorList,
      attributes: {
        'data-testid': 'error-summary'
      }
    }) }}
  {% endif %}
  {% block pageContent %}{% endblock %}
{% endblock %}

{% block footer %}
<div class="govuk-footer">
  <div class="govuk-width-container">
    <div class="govuk-footer__meta">
      <div class="govuk-footer__meta-item govuk-footer__meta-item">
        <span class="govuk-footer__licence-description">
          Maintained by the DWT Software Providers and Insights team at Defra.
        </span>
      </div>
      <div class="govuk-footer__meta-item govuk-footer__meta-item">
        <span class="govuk-footer__licence-description">
          All content is available under the
          <a
            class="govuk-footer__link"
            href="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"
            rel="license">Open Government Licence v3.0</a>, except where otherwise stated
        </span>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block bodyEnd %}
  <script type="module" src="{{ getAssetPath('src/client/javascripts/application.js') }}"></script>
{% endblock %}
