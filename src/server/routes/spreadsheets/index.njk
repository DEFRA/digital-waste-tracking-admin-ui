{% extends 'layouts/page.njk' %}

{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageTitle %}
  {{ pageTitle }} - DWT admin portal
{% endblock %}

{% block pageContent %}

  <form id="login-form" method="POST" action="{{ paths.spreadsheetAdminDelete }}">
    {{
        govukInput({
          id: "key",
          name: "key",
          label: {
            text: "S3 Key",
            classes: "govuk-label--s"
          },
          hint: {
            text: "S3 Key to delete"
          },
          errorMessage: { text: keyError } if keyError
        })
    }}
    {{
        govukButton({
          text: "Delete",
          type: "submit",
          attributes: {
            "data-testid": "next-action-submit-button"
          }
        })
    }}
  </form>
{% endblock %}
