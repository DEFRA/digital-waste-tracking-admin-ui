{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageTitle %}
  Error: {{ pageTitle }} - {{ environmentName }} - {{ serviceName }}
{% endblock %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l" data-testid="app-heading-title">{{ pageTitle }}</h1>
      <p class="govuk-body">You have not been signed in. You will need to try again.</p>
      {{ govukButton({
        text: "Try signing in again",
        href: startSignInPath,
        attributes: { "data-testid": "try-signing-in-again-button" }
      }) }}
    </div>
  </div>
{% endblock %}
