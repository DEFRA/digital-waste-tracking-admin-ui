{% extends 'layouts/page.njk' %}

{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "alert/macro.njk" import appAlert %}

{% block pageTitle %}
  {{ pageTitle }} - DWT admin portal
{% endblock %}

{% block pageContent %}
  {% set hasCredentials = clientCredentials | length > 0 %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if deletedClientName %}
        {{ appAlert({
          variant: "success",
          title: "Software provider deleted",
          text: deletedClientName + " has been deleted.",
          classes: "govuk-!-margin-bottom-7",
          testId: "deleted-alert"
        }) }}
      {% endif %}
      <h1 class="govuk-heading-l" data-testid="app-heading-title">Software providers</h1>
      <p class="govuk-body govuk-!-margin-bottom-7" data-testid="app-page-body">
        Manage the client credentials that software providers use to connect to the Digital Waste Tracking service.
      </p>
      {% if createClientCredentialsPath %}
      {{ govukButton({
        text: "Create new credentials",
        href: createClientCredentialsPath,
        classes: "govuk-button--secondary govuk-!-margin-bottom-7",
        attributes: { "data-testid": "create-credentials-button" }
      }) }}
      {% endif %}
      {% if not hasCredentials %}
        <h2 class="govuk-heading-m" data-testid="client-credentials-empty-heading">Client credentials</h2>
        <p class="govuk-body" data-testid="client-credentials-empty">New client credentials will be shown here.</p>
      {% endif %}
    </div>
  </div>

  {% if hasCredentials %}
    {% set rows = [] %}
    {% for credential in clientCredentials %}
      {% set rows = (rows.push([
        { text: credential.clientName, classes: "app-break-word" },
        { text: credential.clientId, classes: "app-break-word" },
        { text: credential.environment }
      ]), rows) %}
    {% endfor %}

    {# Long client names and IDs wrap in their cells, and the text is smaller, so the table fits the page from 320px wide #}
    {{ govukTable({
      caption: "Client credentials",
      captionClasses: "govuk-table__caption--m",
      classes: "app-table--small-text",
      attributes: {
        'data-module': 'moj-sortable-table',
        'data-testid': 'client-credentials'
      },
      head: [
        { text: "Client name", classes: "app-table__header--half", attributes: { 'aria-sort': 'ascending' } },
        { text: "Client ID", attributes: { 'aria-sort': 'none' } },
        { text: "Environment", attributes: { 'aria-sort': 'none' } }
      ],
      rows: rows
    }) }}
  {% endif %}

{% endblock %}
