{% extends 'layouts/page.njk' %}

{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "alert/macro.njk" import appAlert %}

{% block pageTitle %}
  {{ pageTitle }} - DWT admin portal
{% endblock %}

{# Outside the main wrapper, as the prototype has it, but only on this page #}
{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: softwareProvidersPath,
    classes: "govuk-!-margin-bottom-4",
    attributes: { "data-testid": "back-link" }
  }) }}
{% endblock %}

{% block pageContent %}
  {% if removedSecret %}
    {{ appAlert({
      variant: "success",
      title: "Secret removed",
      text: "The oldest secret for " + removedSecret.clientName + " has been removed.",
      classes: "govuk-!-margin-bottom-7",
      testId: "removed-secret-alert"
    }) }}
  {% endif %}
  {% set rows = [] %}
  {# Youngest first, as the newest secret is the one in use. The older secret,
     which only a client with two secrets has, is the one that can be removed #}
  {% for secret in secrets | sort(attribute="createdAt", reverse=true) %}
    {% set actions = { text: "" } %}
    {% if loop.first and secretCount == 1 %}
      {% set actions = { html: '<a class="govuk-link" href="' + replaceSecretPath + '">Replace secret</a>' | safe } %}
    {% elif not loop.first and removeSecretPath %}
      {% set actions = { html: '<a class="govuk-link" href="' + removeSecretPath + '">Remove secret</a>' | safe } %}
    {% endif %}
    {% set rows = (rows.push([
      { text: secret.createdAt | formatDate("d LLLL yyyy 'at' hh:mmaaa") },
      { text: "[Hidden]" },
      actions
    ]), rows) %}
  {% endfor %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">Software provider</span>
      <h1 class="govuk-heading-l govuk-!-margin-bottom-4" data-testid="app-heading-title">{{ clientName }}</h1>
      <p class="govuk-body govuk-!-margin-bottom-8">
        <strong class="govuk-tag">{{ environment }}</strong>
      </p>
      <dl class="govuk-summary-list govuk-summary-list--no-border govuk-!-margin-bottom-8">
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">
            Client ID
          </dt>
          <dd class="govuk-summary-list__value">
            {{ clientId }}
          </dd>
        </div>
      </dl>
      <h2 class="govuk-heading-m govuk-!-margin-bottom-4">Client secrets for {{ environment }}</h2>
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
          {{ govukTable({
            head: [
              {
                text: "Generated on"
              },
              {
                text: "Client secret"
              },
              {
                text: "Actions"
              }
            ],
            rows: rows
          }) }}
        </div>
      </div>
      {% if secretCount == 1 %}
        {# Adds the secret straight away, as another can be added without risk #}
        <form method="post" action="{{ addSecretPath }}">
          {{ govukButton({
            text: "Add another secret",
            classes: "govuk-button--secondary govuk-!-margin-top-6",
            attributes: { "data-testid": "add-another-secret" }
          }) }}
        </form>
      {% endif %}
      {% if deleteSoftwareProviderPath %}
        <p class="govuk-body govuk-!-margin-top-9">
          <a class="govuk-link" href="{{ deleteSoftwareProviderPath }}" data-testid="delete-software-provider">
            Delete software provider
          </a>
        </p>
      {% endif %}
    </div>
  </div>
{% endblock %}
