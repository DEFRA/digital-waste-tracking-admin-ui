{% extends 'layouts/page.njk' %}

{% from "interruption-card/macro.njk" import appInterruptionCard %}
{% from "report-exposed-credentials/macro.njk" import appReportExposedCredentials %}

{% block pageTitle %}
  {{ pageTitle }} - DWT admin portal
{% endblock %}

{% block pageContent %}
  {% call appInterruptionCard({
    heading: "Are you sure you want to replace the current secret?",
    buttonText: "Yes, replace secret",
    backLink: { text: "Go back to software provider", href: softwareProviderPath }
  }) %}
    <p>The current secret for {{ clientName }} will stop working immediately. Make sure the software provider knows before you continue.</p>
    {{ appReportExposedCredentials(securityTeamEmail) }}
  {% endcall %}
{% endblock %}
