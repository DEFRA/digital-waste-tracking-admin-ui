{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "alert/macro.njk" import appAlert %}

{% block pageTitle %}
  {{ pageTitle }} - DWT admin portal
{% endblock %}

{% block pageContent %}
  <div class="govuk-grid-row">
    {# Its script stops the browser showing the secret again from its back/forward
       cache. Without JavaScript that can't be stopped: going back can show the
       secret again from the browser's memory, although it's only sent once.
       Clear-Site-Data on the next page doesn't prevent it (tried in Chrome) #}
    <div class="govuk-grid-column-two-thirds" data-module="app-show-once" data-leave-to="{{ softwareProviderPath }}">
      <span class="govuk-caption-l" data-testid="app-heading-caption">{{ clientName }}</span>
      <h1 class="govuk-heading-l" data-testid="app-heading-title">{{ pageTitle }}</h1>

      {{ appAlert({
        variant: "warning",
        title: "You must copy the credentials",
        text: "You cannot view the client secret after closing this page.",
        classes: "govuk-!-margin-bottom-7",
        testId: "copy-warning-alert"
      }) }}

      {% if removeOldSecretPath %}
        <div class="govuk-warning-text" data-testid="old-secret-warning">
          <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
          <strong class="govuk-warning-text__text">
            <span class="govuk-visually-hidden">Warning</span>
            The old client secret may still work. Remove it to finish replacing it.
          </strong>
        </div>
        <p class="govuk-body">
          <a class="govuk-link" href="{{ removeOldSecretPath }}" data-testid="remove-old-secret">Remove the old client secret</a>
        </p>
      {% endif %}

      <dl class="govuk-summary-list govuk-!-margin-bottom-4" data-copy-source>
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">Client ID</dt>
          <dd class="govuk-summary-list__value" data-testid="client-id" data-show-once>{{ clientId }}</dd>
        </div>
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">Client secret</dt>
          <dd class="govuk-summary-list__value" data-testid="client-secret" data-show-once>{{ clientSecret }}</dd>
        </div>
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">{{ environment }}</dt>
          <dd class="govuk-summary-list__value">{{ apiUrl }}</dd>
        </div>
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">Generated on</dt>
          <dd class="govuk-summary-list__value">{{ generatedOn }}</dd>
        </div>
      </dl>
    {# Hidden until its script runs. Without JavaScript the credentials can be selected and copied by hand #}
      <div class="app-copy-actions">
        <div class="govuk-button-group" data-module="app-copy" hidden>
          {{ govukButton({
            text: "Copy credentials",
            type: "button",
            classes: "govuk-!-margin-bottom-0 app-copy-button",
            attributes: {
              "aria-label": "Copy client credentials",
              "data-testid": "copy-button"
            }
          }) }}
          <span class="govuk-body app-copy__status" role="status" aria-live="polite" data-testid="copy-status"></span>
        </div>
        {# Outside the hidden copy area, so the page can still be left without JavaScript #}
        {{ govukButton({
          text: "Close",
          href: softwareProviderPath,
          classes: "govuk-button--secondary",
          attributes: { "data-testid": "close-button" }
        }) }}
      </div>
    </div>
  </div>
{% endblock %}
