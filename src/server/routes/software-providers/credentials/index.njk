{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}

{% block pageTitle %}
  {{ pageTitle }} - DWT admin portal
{% endblock %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l" data-testid="app-heading-caption">Manage client credentials</span>
      <h1 class="govuk-heading-l" data-testid="app-heading-title">{{ pageTitle }}</h1>

      {{ govukWarningText({
        text: "Copy the client secret before leaving this page. Once you leave this page, you cannot view the client secret again.",
        attributes: { "data-testid": "copy-warning" }
      }) }}

      {# MoJ Frontend's ticket panel, styled in components/_ticket-panel.scss #}
      <article class="moj-ticket-panel" aria-label="Client credentials generated on {{ generatedOn }}" data-testid="client-credentials-panel">
        <section class="moj-ticket-panel__content moj-ticket-panel__content--blue">
          <dl class="app-credentials" data-copy-source>
            <dt class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1">Generated on</dt>
            <dd class="govuk-body">{{ generatedOn }}</dd>
            <dt class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1">{{ environment }}</dt>
            <dd class="govuk-body">{{ apiUrl }}</dd>
            <dt class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1">Client ID</dt>
            <dd class="govuk-body" data-testid="client-id">{{ clientId }}</dd>
            <dt class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1">Client secret</dt>
            <dd class="govuk-body govuk-!-margin-bottom-0" data-testid="client-secret">{{ clientSecret }}</dd>
          </dl>
        </section>
      </article>

      {# Hidden until its script runs. Without JavaScript the credentials can be selected and copied by hand #}
      <div class="app-copy" data-module="app-copy" hidden>
        {{ govukButton({
          text: "Copy",
          type: "button",
          classes: "govuk-button--secondary govuk-!-margin-bottom-0",
          attributes: {
            "aria-label": "Copy client credentials",
            "data-testid": "copy-button"
          }
        }) }}
        <span class="govuk-body app-copy__status" role="status" aria-live="polite" data-testid="copy-status"></span>
      </div>

      {{ govukButton({
        text: "Close",
        href: softwareProvidersPath,
        classes: "govuk-!-margin-top-6",
        attributes: { "data-testid": "close-button" }
      }) }}
    </div>
  </div>
{% endblock %}
