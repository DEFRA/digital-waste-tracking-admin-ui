{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}

{% block pageTitle %}
  {{ "Error: " if errors }}{{ pageTitle }} - DWT admin portal
{% endblock %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l" data-testid="app-heading-caption">{{ caption }}</span>
      <h1 class="govuk-heading-l" data-testid="app-heading-title">{{ pageTitle }}</h1>

      <form method="post" novalidate data-module="app-single-submit">
        {{ govukInput({
          label: {
            text: "Client name",
            classes: "govuk-label--s"
          },
          hint: {
            text: "Enter the name of the software provider and software package, using letters and underscores only. For example, Waste_Technologies_Software"
          },
          id: "clientName",
          name: "clientName",
          value: clientName,
          classes: "govuk-!-width-two-thirds",
          autocomplete: "off",
          spellcheck: false,
          errorMessage: errors.clientName and { text: errors.clientName } or undefined
        }) }}

        <div class="govuk-button-group">
          {{ govukButton({
            text: "Generate credentials",
            preventDoubleClick: true,
            attributes: { "data-testid": "generate-credentials-button" }
          }) }}
          <a class="govuk-link" href="{{ softwareProvidersPath }}" data-testid="cancel-link">Cancel</a>
        </div>
      </form>
    </div>
  </div>
{% endblock %}
