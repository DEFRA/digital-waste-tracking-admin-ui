# Local development environment variables, for running the admin UI with
# `npm run dev` against the backends from `npm run dev:deps` (see compose.yml).
# Every value here is made up and local-only, so none of them are secrets.
#
# Usage:
#   cp .env.example .env
#   npm run dev:deps
#   npm run dev

# Log level (defaults to info)
LOG_LEVEL=debug

# Signing in: floci-az stands in for Entra ID (add "127.0.0.1 floci-az" to
# /etc/hosts, see README.md), and Floci for AWS STS, which issues the token the
# admin UI proves itself to Entra ID with
AWS_REGION=eu-west-2
AWS_ENDPOINT_URL_STS=http://localhost:4599
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_CREDENTIAL_EXPIRATION=2099-01-01T00:00:00Z
# floci-az's dev app and tenant
ENTRA_CLIENT_ID=11111111-1111-1111-1111-111111111111
ENTRA_DISCOVERY_URI=http://floci-az:4577/00000000-0000-0000-0000-000000000002/v2.0/.well-known/openid-configuration

# The backends started by `npm run dev:deps`
WASTE_ORGANISATION_SERVICE_URL=http://localhost:3004
DWT_CLIENT_SYNC_SERVICE_URL=http://localhost:3005

# Accepted by the organisation backend and client sync in the shared compose stack
SERVICE_AUTH_PASSWORD=local-admin-ui
