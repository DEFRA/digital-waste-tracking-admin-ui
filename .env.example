# Local development environment variables, for running the admin UI with
# `npm run dev` against the backends from `npm run dev:deps` (see compose.yml).
# Every value here is made up and local-only, so none of them are secrets.
#
# Usage:
#   cp .env.example .env
#   npm run dev:deps
#   npm run dev

# Log level (defaults to info)
LOG_LEVEL=debug

# Login: username "local", password "local"
# Add more users as base64 encoded username=password pairs, e.g. echo -n "username=password" | base64
USER_BASIC_AUTH_LOCAL=bG9jYWw9bG9jYWw=

# The backends started by `npm run dev:deps`
WASTE_ORGANISATION_SERVICE_URL=http://localhost:3004
DWT_CLIENT_SYNC_SERVICE_URL=http://localhost:3005

# Accepted by the organisation backend and client sync in the shared compose stack
SERVICE_AUTH_PASSWORD=local-admin-ui
